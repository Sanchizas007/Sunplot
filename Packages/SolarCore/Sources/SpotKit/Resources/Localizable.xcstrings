    "exposure.fullSun.meaning" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rajčata, papriky, levandule, většina zeleniny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomater, peberfrugt, lavendel, de fleste grøntsager."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomaten, Paprika, Lavendel, die meisten Gemüsesorten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ντομάτες, πιπεριές, λεβάντα, τα περισσότερα λαχανικά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomatoes, peppers, lavender, most vegetables."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomates, pimientos, lavanda, casi todas las hortalizas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomaatit, paprikat, laventeli, useimmat vihannekset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomates, poivrons, lavande, la plupart des légumes."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paradicsom, paprika, levendula, a legtöbb zöldség."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomat, paprika, lavender, sebagian besar sayuran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomodori, peperoni, lavanda, quasi tutti gli ortaggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トマト、ピーマン、ラベンダー、多くの野菜。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "토마토, 피망, 라벤더 등 대부분의 채소."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomater, paprika, lavendel, de fleste grønnsaker."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomaten, paprika's, lavendel, de meeste groenten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomidory, papryka, lawenda, większość warzyw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomate, pimentão, lavanda, quase toda hortaliça."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roșii, ardei, lavandă, majoritatea legumelor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помидоры, перец, лаванда, большинство овощей."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paradajky, papriky, levanduľa, väčšina zeleniny."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomater, paprika, lavendel, de flesta grönsaker."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domates, biber, lavanta, sebzelerin çoğu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помідори, перець, лаванда, більшість овочів."
          }
        },
        "zh-Hans" : {
