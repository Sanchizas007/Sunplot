    "exposure.fullShade.meaning" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapradiny a bohyšky. Ovoce tu nedozraje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bregner og funkier. Frugt modner ikke her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farne und Funkien. Früchte reifen hier nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φτέρες και χόστες. Τα φρούτα δεν ωριμάζουν εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferns and hostas. Fruit will not ripen here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helechos y hostas. Aquí la fruta no madura."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saniaisia ja päivänliljoja. Hedelmät eivät kypsy täällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fougères et hostas. Aucun fruit ne mûrira ici."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Páfrányok és árnyliliomok. A gyümölcs itt nem érik be."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakis dan hosta. Buah tidak akan matang di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Felci e hoste. Qui la frutta non matura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シダやギボウシ向き。ここで果実は熟しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고사리와 비비추. 여기서 열매는 익지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bregner og funkia. Frukt modnes ikke her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varens en hosta's. Fruit rijpt hier niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paprocie i funkie. Owoce tu nie dojrzeją."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samambaias e hostas. Aqui a fruta não amadurece."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferigi și hosta. Fructele nu se coc aici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папоротники и хосты. Плоды здесь не вызреют."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Papraď a hosty. Ovocie tu nedozrie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ormbunkar och funkior. Frukt mognar inte här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eğrelti otu ve hosta. Burada meyve olgunlaşmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папороті та хости. Плоди тут не достигнуть."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适合蕨类和玉簪。果实在这里长不熟。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "適合蕨類和玉簪。果實在這裡長不熟。"
          }
        }
      }
    },
