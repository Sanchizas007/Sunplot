    "exposure.partSun.meaning" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stačí na fazole, mrkev a většinu bylinek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nok til bønner, gulerødder og de fleste krydderurter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reicht für Bohnen, Karotten und die meisten Kräuter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αρκεί για φασόλια, καρότα και τα περισσότερα βότανα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enough for beans, carrots and most herbs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suficiente para judías, zanahorias y casi todas las hierbas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riittää pavuille, porkkanoille ja useimmille yrteille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suffisant pour les haricots, les carottes et la plupart des herbes."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elég babnak, sárgarépának és a legtöbb fűszernövénynek."
