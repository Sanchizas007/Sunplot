    "Waiting for approval. It will unlock as soon as that comes through." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čeká se na schválení. Odemkne se, jakmile dorazí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venter på godkendelse. Det låses op, så snart den kommer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warte auf Freigabe. Sobald sie da ist, wird freigeschaltet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναμονή έγκρισης. Θα ξεκλειδωθεί μόλις έρθει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando la aprobación. Se desbloqueará en cuanto llegue."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odotetaan hyväksyntää. Se avautuu heti, kun hyväksyntä tulee."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente d’approbation. Le déblocage suivra dès qu’elle arrive."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jóváhagyásra vár. Feloldódik, amint megérkezik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menunggu persetujuan. Akan terbuka begitu persetujuan datang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In attesa di approvazione. Si sbloccherà appena arriva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "承認待ちです。承認され次第、利用できるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "승인을 기다리고 있습니다. 승인되면 바로 열립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venter på godkjenning. Det låses opp så snart den kommer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wachten op goedkeuring. Het wordt ontgrendeld zodra die binnen is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czekamy na zatwierdzenie. Odblokuje się, gdy tylko przyjdzie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguardando aprovação. Vai liberar assim que ela chegar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se așteaptă aprobarea. Se va debloca imediat ce vine."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ждём подтверждения. Откроется, как только оно придёт."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čaká sa na schválenie. Odomkne sa, len čo dorazí."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väntar på godkännande. Det låses upp så fort det kommer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onay bekleniyor. Onay gelir gelmez kilidi açılacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очікуємо схвалення. Розблокується, щойно воно надійде."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在等待批准。批准之后就会解锁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在等待核准。核准之後就會解鎖。"
          }
        }
      }
    },
    "Wave the phone in a figure of eight to calibrate the compass. Keep away from speakers, magnets and car dashboards." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pohybujte telefonem v osmičce, abyste zkalibrovali kompas. Držte se dál od reproduktorů, magnetů a palubních desek aut."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vift med telefonen i et ottetal for at kalibrere kompasset. Hold dig væk fra højttalere, magneter og bilers instrumentbrætter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschreibe mit dem Telefon eine Acht, um den Kompass zu kalibrieren. Halte Abstand zu Lautsprechern, Magneten und Armaturenbrettern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κούνα το τηλέφωνο σε σχήμα οκτώ για να βαθμονομήσεις την πυξίδα. Μείνε μακριά από ηχεία, μαγνήτες και ταμπλό αυτοκινήτων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuja un ocho en el aire con el teléfono para calibrar la brújula. Aléjate de altavoces, imanes y salpicaderos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heiluta puhelinta kahdeksikkoa piirtäen kalibroidaksesi kompassin. Pysy kaukana kaiuttimista, magneeteista ja auton kojelaudoista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décrivez un huit avec le téléphone pour calibrer la boussole. Éloignez-vous des haut-parleurs, aimants et tableaux de bord."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mozgasd a telefont nyolcas alakban az iránytű kalibrálásához. Maradj távol hangszóróktól, mágnesektől és autók műszerfalától."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerakkan ponsel membentuk angka delapan untuk mengkalibrasi kompas. Jauhi speaker, magnet, dan dasbor mobil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disegna un otto nell'aria con il telefono per calibrare la bussola. Stai lontano da casse, magneti e cruscotti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端末で8の字を描いてコンパスを調整してください。スピーカー、磁石、車のダッシュボードからは離してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기로 8자를 그려 나침반을 보정하세요. 스피커, 자석, 자동차 대시보드에서 떨어뜨리세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vift telefonen i et åttetall for å kalibrere kompasset. Hold deg unna høyttalere, magneter og instrumentbord i biler."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beweeg de telefoon in een acht om het kompas te ijken. Blijf weg bij speakers, magneten en dashboards."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatocz telefonem ósemkę, żeby skalibrować kompas. Trzymaj się z dala od głośników, magnesów i deski rozdzielczej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça um oito no ar com o telefone para calibrar a bússola. Fique longe de caixas de som, ímãs e painéis de carro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mișcă telefonul în formă de opt ca să calibrezi busola. Stai departe de difuzoare, magneți și bordurile mașinilor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опишите телефоном «восьмёрку», чтобы настроить компас. Держитесь подальше от колонок, магнитов и автомобильной панели."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pohybujte telefónom v osmičke, aby ste skalibrovali kompas. Držte sa ďalej od reproduktorov, magnetov a palubných dosiek áut."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vicka telefonen i en åtta för att kalibrera kompassen. Håll dig borta från högtalare, magneter och bilars instrumentbrädor."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pusulayı ayarlamak için telefonla havada sekiz çiz. Hoparlörlerden, mıknatıslardan ve araç torpidosundan uzak dur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помахайте телефоном вісімкою, щоб відкалібрувати компас. Тримайтеся подалі від динаміків, магнітів і панелей авто."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拿着手机画 8 字来校准指南针。请远离音箱、磁铁和汽车仪表台。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拿著手機畫 8 字來校正指南針。請遠離喇叭、磁鐵和汽車儀表板。"
          }
        }
      }
    },
