    "Notifications are switched off for Sunplot. Turn them on in Settings and this will start working." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznámení jsou pro Sunplot vypnutá. Zapněte je v Nastavení a začne to fungovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underretninger er slået fra for Sunplot. Slå dem til i Indstillinger, så begynder det at virke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitteilungen sind für Sunplot ausgeschaltet. Schalte sie in den Einstellungen ein, dann funktioniert das hier."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ειδοποιήσεις είναι απενεργοποιημένες για το Sunplot. Ενεργοποίησέ τις στις Ρυθμίσεις και θα αρχίσει να λειτουργεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones están desactivadas para Sunplot. Actívalas en Ajustes y esto empezará a funcionar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmoitukset on kytketty pois Sunplotilta. Kytke ne päälle Asetuksista, niin tämä alkaa toimia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications sont désactivées pour Sunplot. Activez-les dans Réglages pour que cela fonctionne."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az értesítések ki vannak kapcsolva a Sunplot számára. Kapcsold be őket a Beállításokban, és működni fog."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikasi dimatikan untuk Sunplot. Nyalakan di Pengaturan dan ini akan mulai bekerja."
          }
