    "The year is where the surprises are — see when full sun starts and ends." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Překvapení jsou v roce — podívejte se, kdy plné slunce začíná a končí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er over året, overraskelserne er — se, hvornår fuld sol begynder og slutter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Jahr stecken die Überraschungen — sieh, wann die volle Sonne beginnt und endet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι εκπλήξεις βρίσκονται στο έτος — δες πότε αρχίζει και τελειώνει ο πλήρης ήλιος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sorpresas están en el año: mira cuándo empieza y acaba el sol pleno."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yllätykset ovat vuodessa — katso, milloin täysi aurinko alkaa ja päättyy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les surprises sont dans l’année — voyez quand le plein soleil commence et finit."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A meglepetések az évben vannak — nézd meg, mikor kezdődik és ér véget a teljes napfény."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kejutan ada di sepanjang tahun — lihat kapan matahari penuh dimulai dan berakhir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sorprese stanno nell'anno: guarda quando comincia e finisce il pieno sole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "驚きは一年の変化にあります。終日陽がいつ始まり、いつ終わるかが分かります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "뜻밖의 변화는 한 해에 있습니다. 양지가 언제 시작되고 끝나는지 확인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er gjennom året overraskelsene finnes — se når full sol begynner og slutter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verrassingen zitten in het jaar: zie wanneer volle zon begint en eindigt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niespodzianki kryją się w roku: zobacz, kiedy pełne słońce się zaczyna i kończy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As surpresas estão no ano: veja quando o sol pleno começa e termina."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surprizele sunt în an — vezi când începe și se termină soarele plin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Главные сюрпризы — в годе: видно, когда полное солнце начинается и заканчивается."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prekvapenia sú v roku — pozrite sa, kedy plné slnko začína a končí."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det är under året överraskningarna finns — se när full sol börjar och slutar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sürprizler yılda saklı: tam güneşin ne zaman başlayıp bittiğini gör."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
