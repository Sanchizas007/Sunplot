    "Fruit will not ripen properly under six hours." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter sechs Stunden reifen die Früchte nicht richtig aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con menos de seis horas la fruta no madura bien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En dessous de six heures, les fruits ne mûrissent pas correctement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto le sei ore la frutta non matura bene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6時間を切ると果実はうまく熟しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여섯 시간 미만이면 열매가 제대로 익지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onder zes uur rijpt fruit niet goed."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poniżej sześciu godzin owoce nie dojrzeją jak należy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com menos de seis horas a fruta não amadurece direito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меньше шести часов — плоды толком не вызреют."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altı saatin altında meyve doğru düzgün olgunlaşmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不足六小时，果实长不好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不足六小時，果實長不好。"
          }
        }
      }
    },
