    "Bolts in a hot, wide-open spot. Afternoon shade suits it." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V horku na otevřeném místě vybíhá do květu. Svědčí mu odpolední stín."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skyder i blomst på et varmt, åbent sted. Eftermiddagsskygge passer den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schießt an einem heißen, offenen Platz. Nachmittagsschatten tut ihm gut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανεβαίνει σε σπόρο σε ζεστό, ανοιχτό σημείο. Της ταιριάζει η απογευματινή σκιά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se espiga en un sitio caluroso y despejado. Le va bien la sombra de la tarde."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menee siemenelle kuumassa, avoimessa paikassa. Iltapäivävarjo sopii sille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monte en graine dans un endroit chaud et dégagé. L’ombre de l’après-midi lui convient."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forró, nyílt helyen felmagzik. A délutáni árnyék jót tesz neki."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cepat berbunga di tempat panas dan terbuka. Cocok dengan naungan sore."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In un posto caldo e aperto va a seme. Gli giova l'ombra del pomeriggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暑く開けた場所ではとう立ちします。午後の日陰が向いています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "덥고 트인 자리에서는 꽃대가 올라옵니다. 오후 그늘이 좋습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Går i blomst i et varmt, åpent sted. Ettermiddagsskygge passer den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schiet door op een warme, open plek. Schaduw in de middag bevalt beter."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W gorącym, odsłoniętym miejscu wybija w kwiat. Lubi cień po południu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em lugar quente e aberto, vai a semente. Gosta de sombra à tarde."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dă în floare repede într-un loc fierbinte și deschis. Umbra de după-amiază îi priește."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На жаре и открытом месте идёт в стрелку. Любит тень после полудня."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na horúcom, otvorenom mieste vybieha do kvetu. Poobedný tieň mu svedčí."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjuter i blom på en het, öppen plats. Eftermiddagsskugga passar den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıcak ve açık yerde tohuma kaçar. Öğleden sonra gölge ona iyi gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Йде в стрілку на спекотному відкритому місці. Краще з післяобідньою тінню."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在又热又空旷的地方容易抽薹。下午有阴更合适。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在又熱又空曠的地方容易抽苔。下午有陰更合適。"
          }
        }
      }
    },
