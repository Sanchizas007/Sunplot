    "Leaves scorch where the sun is strong." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listy se spálí tam, kde je slunce silné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bladene svides, hvor solen er stærk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Blätter verbrennen, wo die Sonne stark ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα φύλλα καίγονται εκεί που ο ήλιος είναι δυνατός."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las hojas se queman donde el sol pega fuerte."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lehdet kärventyvät, missä aurinko on voimakas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les feuilles brûlent là où le soleil est fort."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A levelek megperzselődnek, ahol erős a nap."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daun hangus di tempat matahari terik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dove il sole picchia le foglie si bruciano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日差しが強い場所では葉が焼けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "햇빛이 센 자리에서는 잎이 탑니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bladene svis der solen er sterk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waar de zon fel is, verbranden de bladeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam, gdzie słońce mocno praży, liście się przypalają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As folhas queimam onde o sol é forte."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frunzele se pârjolesc acolo unde soarele e puternic."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На сильном солнце листья выгорают."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listy sa spália tam, kde je slnko silné."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bladen svedas där solen är stark."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güneşin sert olduğu yerde yapraklar yanar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Листя обпікається там, де сонце сильне."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阳光太强的地方叶子会灼伤。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "陽光太強的地方葉子會曬傷。"
          }
        }
      }
    },
