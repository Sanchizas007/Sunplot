    "Bolts in a hot, wide-open spot. Afternoon shade suits it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schießt an einem heißen, offenen Platz. Nachmittagsschatten tut ihm gut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se espiga en un sitio caluroso y despejado. Le va bien la sombra de la tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monte en graine dans un endroit chaud et dégagé. L’ombre de l’après-midi lui convient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In un posto caldo e aperto va a seme. Gli giova l'ombra del pomeriggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暑く開けた場所ではとう立ちします。午後の日陰が向いています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "덥고 트인 자리에서는 꽃대가 올라옵니다. 오후 그늘이 좋습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schiet door op een warme, open plek. Schaduw in de middag bevalt beter."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W gorącym, odsłoniętym miejscu wybija w kwiat. Lubi cień po południu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em lugar quente e aberto, vai a semente. Gosta de sombra à tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На жаре и открытом месте идёт в стрелку. Любит тень после полудня."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıcak ve açık yerde tohuma kaçar. Öğleden sonra gölge ona iyi gelir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在又热又空旷的地方容易抽薹。下午有阴更合适。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在又熱又空曠的地方容易抽苔。下午有陰更合適。"
          }
        }
      }
    },
