    "You know what this spot gets today. The year is where the surprises are." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Víte, co toto místo dostává dnes. Překvapení jsou v roce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du ved, hvad dette sted får i dag. Det er over året, overraskelserne er."
