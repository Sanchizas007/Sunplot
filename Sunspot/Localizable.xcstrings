    "The year is where the surprises are — see when full sun starts and ends." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Jahr stecken die Überraschungen — sieh, wann die volle Sonne beginnt und endet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sorpresas están en el año: mira cuándo empieza y acaba el sol pleno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les surprises sont dans l’année — voyez quand le plein soleil commence et finit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sorprese stanno nell'anno: guarda quando comincia e finisce il pieno sole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "驚きは一年の変化にあります。終日陽がいつ始まり、いつ終わるかが分かります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "뜻밖의 변화는 한 해에 있습니다. 양지가 언제 시작되고 끝나는지 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verrassingen zitten in het jaar: zie wanneer volle zon begint en eindigt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niespodzianki kryją się w roku: zobacz, kiedy pełne słońce się zaczyna i kończy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As surpresas estão no ano: veja quando o sol pleno começa e termina."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Главные сюрпризы — в годе: видно, когда полное солнце начинается и заканчивается."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
