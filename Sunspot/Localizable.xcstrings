    "A shade bed. Ferns and hostas rather than anything that has to ripen." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stinný záhon. Kapradiny a bohyšky spíš než něco, co má dozrávat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et skyggebed. Bregner og funkier snarere end noget, der skal modnes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Schattenbeet. Farne und Funkien statt allem, was reifen muss."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα σκιερό παρτέρι. Φτέρες και χόστες μάλλον παρά κάτι που πρέπει να ωριμάσει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bancal de sombra. Helechos y hostas, nada que tenga que madurar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varjopenkki. Saniaisia ja päivänliljoja, ei mitään, minkä pitäisi kypsyä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un massif d’ombre. Fougères et hostas plutôt que ce qui doit mûrir."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Árnyékos ágyás. Inkább páfrányok és árnyliliomok, mint bármi, aminek érnie kell."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedengan teduh. Pakis dan hosta, bukan sesuatu yang harus matang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un'aiuola in ombra. Felci e hoste, non certo qualcosa che deve maturare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日陰の花壇です。実らせるものより、シダやギボウシ向き。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그늘진 화단입니다. 열매를 맺는 작물보다 고사리와 비비추가 어울립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et skyggebed. Bregner og funkia heller enn noe som skal modnes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een schaduwbed. Varens en hosta's, niets dat moet rijpen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grządka w cieniu. Paprocie i funkie, a nie coś, co musi dojrzeć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um canteiro de sombra. Samambaias e hostas, nada que precise amadurecer."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un strat la umbră. Ferigi și hosta, mai degrabă decât ceva care trebuie să se coacă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теневая грядка. Папоротники и хосты, а не то, чему нужно созреть."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienistý záhon. Papraď a hosty skôr než niečo, čo má dozrievať."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En skuggbädd. Ormbunkar och funkior snarare än något som ska mogna."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gölge bir tarh. Olgunlaşması gereken bir şey değil, eğrelti otu ve hosta."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тіниста грядка. Папороті й хости, а не те, що має дозріти."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是一块背阴的地。适合蕨类和玉簪，而不是需要成熟的作物。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是一塊背陰的地。適合蕨類和玉簪，而不是需要成熟的作物。"
          }
        }
      }
    },
    "A word before it reaches the spot, so a short winter afternoon is not missed." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozornění dřív, než slunce dorazí na místo, ať vám neujde krátké zimní odpoledne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et praj, før den når stedet, så en kort vintereftermiddag ikke går tabt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Hinweis, bevor sie die Stelle erreicht — damit ein kurzer Winternachmittag nicht verpasst wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια ειδοποίηση πριν φτάσει ο ήλιος στο σημείο, ώστε να μη χαθεί ένα σύντομο χειμωνιάτικο απόγευμα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un aviso antes de que el sol llegue al punto, para no perder una tarde corta de invierno."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muistutus ennen kuin aurinko tavoittaa paikan, jottei lyhyt talvi-iltapäivä jää huomaamatta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mot avant qu’il n’atteigne l’endroit, pour ne pas manquer un court après-midi d’hiver."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szólunk, mielőtt a nap eléri a helyet, hogy egy rövid téli délután se maradjon ki."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemberitahuan sebelum matahari tiba di titik itu, supaya sore musim dingin yang singkat tidak terlewat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un avviso prima che il sole arrivi sul punto, per non perdere un breve pomeriggio invernale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日が差す前にお知らせします。冬の短い午後を逃しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해가 자리에 닿기 전에 알려 드립니다. 짧은 겨울 오후를 놓치지 마세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et varsel før den når stedet, slik at en kort vinterettermiddag ikke går tapt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een seintje voordat de zon de plek bereikt, zodat je een korte wintermiddag niet mist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sygnał, zanim słońce dojdzie do miejsca, żeby nie przegapić krótkiego zimowego popołudnia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um aviso antes de o sol chegar ao ponto, para não perder uma tarde curta de inverno."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un avertisment înainte ca soarele să ajungă în loc, ca să nu ratezi o după-amiază scurtă de iarnă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предупредит до того, как солнце дойдёт до точки, — короткий зимний день не пропустите."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozornenie skôr, ako slnko dorazí na miesto, aby vám neušlo krátke zimné popoludnie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett påpekande innan solen når platsen, så att en kort vintereftermiddag inte missas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güneş noktaya varmadan önce haber verir, kısa bir kış öğleden sonrası kaçmasın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нагадування, перш ніж сонце дійде до точки, щоб не проґавити короткий зимовий день."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阳光到达之前先提醒你，冬天短短的下午不会错过。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "陽光到達之前先提醒你，冬天短短的下午不會錯過。"
          }
        }
      }
    },
