    "Happy in shade, and will take over a bed given the chance." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve stínu se mu daří a při první příležitosti zaplevelí celý záhon."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trives i skygge og tager et helt bed, hvis den får chancen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommt im Schatten gut zurecht und übernimmt ein Beet, wenn man sie lässt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αισθάνεται καλά στη σκιά και θα καταλάβει ολόκληρο το παρτέρι αν του δοθεί η ευκαιρία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está a gusto en sombra y se adueña del bancal si la dejas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viihtyy varjossa ja valtaa penkin, jos saa tilaisuuden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se plaît à l’ombre, et envahit un massif si on la laisse faire."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jól érzi magát az árnyékban, és ha teheti, elfoglalja az egész ágyást."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senang di tempat teduh dan akan menguasai satu bedengan jika diberi kesempatan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta bene all'ombra e, se la lasci fare, prende tutta l'aiuola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日陰を好み、放っておくと花壇を覆い尽くします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그늘을 좋아하고, 두면 화단 전체를 덮습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trives i skygge og tar over et helt bed om den får sjansen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houdt van schaduw en neemt het hele bed over als je het laat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobrze czuje się w cieniu i zajmie całą grządkę, jeśli jej pozwolisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gosta de sombra e toma conta do canteiro se deixar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se simte bine la umbră și va acoperi un strat întreg dacă i se dă ocazia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хорошо растёт в тени и займёт всю грядку, если дать волю."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V tieni sa mu darí a pri prvej príležitosti zaplevelí celý záhon."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trivs i skugga och tar över en bädd om den får chansen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gölgede mutludur, fırsat verirsen tarhın tamamını kaplar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добре почувається в тіні й за першої нагоди захопить усю грядку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "喜阴，放任不管会占满整块地。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "喜陰，放著不管會佔滿整塊地。"
          }
        }
      }
    },
