    "Six hours or more. Tomatoes, peppers and most vegetables want this window." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šest hodin nebo víc. Rajčata, papriky a většina zeleniny chtějí právě toto okno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seks timer eller mere. Tomater, peberfrugt og de fleste grøntsager vil have dette vindue."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sechs Stunden oder mehr. Tomaten, Paprika und die meisten Gemüsesorten brauchen dieses Fenster."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έξι ώρες ή περισσότερο. Οι ντομάτες, οι πιπεριές και τα περισσότερα λαχανικά θέλουν αυτό το παράθυρο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seis horas o más. Tomates, pimientos y la mayoría de hortalizas quieren esta franja."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuusi tuntia tai enemmän. Tomaatit, paprikat ja useimmat vihannekset haluavat tämän ikkunan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Six heures ou plus. Tomates, poivrons et la plupart des légumes veulent cette fenêtre."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hat óra vagy több. A paradicsom, a paprika és a legtöbb zöldség ezt az ablakot kéri."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enam jam atau lebih. Tomat, paprika, dan sebagian besar sayuran menginginkan jendela ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei ore o più. Pomodori, peperoni e quasi tutti gli ortaggi vogliono questa fascia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6時間以上。トマト、ピーマン、多くの野菜はこの時間を必要とします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여섯 시간 이상. 토마토, 피망을 비롯한 대부분의 채소가 이만큼을 원합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seks timer eller mer. Tomater, paprika og de fleste grønnsaker vil ha dette vinduet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zes uur of meer. Tomaten, paprika's en de meeste groenten willen dit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sześć godzin lub więcej. Pomidory, papryka i większość warzyw chcą właśnie tyle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seis horas ou mais. Tomate, pimentão e a maioria das hortaliças querem essa faixa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Șase ore sau mai mult. Roșiile, ardeii și majoritatea legumelor vor această fereastră."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шесть часов и больше. Помидорам, перцу и большинству овощей нужно именно это."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šesť hodín alebo viac. Paradajky, papriky a väčšina zeleniny chcú práve toto okno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sex timmar eller mer. Tomater, paprika och de flesta grönsaker vill ha det här fönstret."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altı saat ve üzeri. Domates, biber ve sebzelerin çoğu bunu ister."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шість годин і більше. Помідори, перець і більшість овочів хочуть саме такого вікна."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "六小时以上。番茄、甜椒和多数蔬菜都要这个时长。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "六小時以上。番茄、甜椒和多數蔬菜都要這個時長。"
          }
        }
      }
    },
