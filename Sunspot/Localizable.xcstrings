          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "意外都在全年变化里：看看全日照什么时候开始、什么时候结束。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "意外都在全年變化裡：看看全日照什麼時候開始、什麼時候結束。"
          }
        }
      }
    },
