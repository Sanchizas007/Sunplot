    "You know what this spot gets today. The year is where the surprises are." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du weißt, was diese Stelle heute bekommt. Die Überraschungen stecken im Jahr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya sabes lo que recibe este punto hoy. Las sorpresas están en el año."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous savez ce que cet endroit reçoit aujourd’hui. Les surprises sont dans l’année."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sai già quanto prende oggi questo punto. Le sorprese stanno nell'anno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日の日差しはもう分かりました。驚きは一年の変化にあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 이 자리가 받는 햇빛은 이미 아셨습니다. 뜻밖의 변화는 한 해에 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je weet wat deze plek vandaag krijgt. De verrassingen zitten in het jaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiesz już, ile to miejsce dostaje dzisiaj. Niespodzianki kryją się w roku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você já sabe quanto este ponto recebe hoje. As surpresas estão no ano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько точка получает сегодня, вы знаете. Главные сюрпризы — в годе."
