    "Hours of direct sun at your spot, counting the roofs and trees in the way." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodiny přímého slunce na vašem místě s ohledem na střechy a stromy v cestě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timer med direkte sol på dit sted, når tage og træer i vejen er regnet med."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stunden direkter Sonne an deiner Stelle — Dächer und Bäume eingerechnet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ώρες άμεσου ήλιου στο σημείο σου, αφού ληφθούν υπόψη οι στέγες και τα δέντρα που μπαίνουν στη μέση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Horas de sol directo en tu punto, contando los tejados y árboles que estorban."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suoran auringon tunnit paikassasi, kun tiellä olevat katot ja puut on laskettu mukaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heures de soleil direct à votre emplacement, toits et arbres compris."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A közvetlen napfény órái a helyeden, az útban lévő tetőkkel és fákkal együtt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jam sinar matahari langsung di titikmu, dengan atap dan pohon yang menghalangi ikut dihitung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ore di sole diretto sul tuo punto, contando tetti e alberi di mezzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屋根や木立を差し引いた、その場所の直射日光の時間です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가로막는 지붕과 나무를 반영한, 그 자리의 직사광선 시간입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timer med direkte sol på stedet ditt, med tak og trær i veien regnet med."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uren directe zon op jouw plek, met de daken en bomen ertussen meegerekend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godziny bezpośredniego słońca w twoim miejscu, z uwzględnieniem dachów i drzew po drodze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Horas de sol direto no seu ponto, contando telhados e árvores no caminho."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orele de soare direct în locul tău, cu acoperișurile și copacii din cale luați în calcul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часы прямого солнца на вашей точке с учётом крыш и деревьев вокруг."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodiny priameho slnka na vašom mieste s ohľadom na strechy a stromy v ceste."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timmar med direkt sol på din plats, med hänsyn till taken och träden i vägen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noktandaki doğrudan güneş saatleri, aradaki çatılar ve ağaçlar hesaba katılarak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Години прямого сонця у вашій точці з урахуванням дахів і дерев на шляху."
          }
        },
        "zh-Hans" : {
