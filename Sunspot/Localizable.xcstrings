          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot의 알림이 꺼져 있습니다. 설정에서 켜면 작동합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsler er slått av for Sunplot. Slå dem på i Innstillinger, så begynner dette å virke."
          }
