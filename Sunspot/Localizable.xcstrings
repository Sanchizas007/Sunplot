    "Happy in shade, and will take over a bed given the chance." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommt im Schatten gut zurecht und übernimmt ein Beet, wenn man sie lässt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está a gusto en sombra y se adueña del bancal si la dejas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se plaît à l’ombre, et envahit un massif si on la laisse faire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta bene all'ombra e, se la lasci fare, prende tutta l'aiuola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日陰を好み、放っておくと花壇を覆い尽くします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그늘을 좋아하고, 두면 화단 전체를 덮습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houdt van schaduw en neemt het hele bed over als je het laat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobrze czuje się w cieniu i zajmie całą grządkę, jeśli jej pozwolisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gosta de sombra e toma conta do canteiro se deixar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хорошо растёт в тени и займёт всю грядку, если дать волю."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gölgede mutludur, fırsat verirsen tarhın tamamını kaplar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "喜阴，放任不管会占满整块地。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "喜陰，放著不管會佔滿整塊地。"
          }
        }
      }
    },
