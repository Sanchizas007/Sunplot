    "Press and hold the map to place your spot." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stiskněte a podržte mapu, abyste umístili své místo."
