    "That purchase could not be verified. Nothing has been charged." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nákup se nepodařilo ověřit. Nic nebylo strženo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Købet kunne ikke bekræftes. Der er ikke trukket penge."
          }
