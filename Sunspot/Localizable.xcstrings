    "Something you will recognise: the bed by the fence, the balcony, the shed roof." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas, das du wiedererkennst: das Beet am Zaun, der Balkon, das Schuppendach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo que reconozcas: el bancal de la valla, el balcón, el tejado del cobertizo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelque chose que vous reconnaîtrez : le massif près de la clôture, le balcon, le toit de l’abri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcosa che riconosci: l'aiuola vicino alla recinzione, il balcone, il tetto del capanno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あとで分かる名前を。フェンス際の花壇、ベランダ、物置の屋根など。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나중에 알아볼 이름으로. 울타리 옆 화단, 발코니, 창고 지붕처럼."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iets dat je herkent: het bed bij de schutting, het balkon, het schuurdak."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coś, co rozpoznasz: grządka przy płocie, balkon, dach szopy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo que você reconheça: o canteiro da cerca, a varanda, o telhado do galpão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы вы узнали: грядка у забора, балкон, крыша сарая."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanıyacağın bir ad: çitin yanındaki tarh, balkon, kulübenin çatısı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起个一眼认得出的名字：篱笆边的地、阳台、棚顶。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取個一眼認得出的名字：籬笆邊的地、陽台、棚頂。"
          }
        }
      }
    },
