    "Today's hours on the home screen, without opening anything." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dnešní hodiny na domovské obrazovce, aniž byste cokoli otevírali."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagens timer på startskærmen, uden at åbne noget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die heutigen Stunden auf dem Home-Bildschirm, ohne etwas zu öffnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι σημερινές ώρες στην αρχική οθόνη, χωρίς να ανοίξεις τίποτα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las horas de hoy en la pantalla de inicio, sin abrir nada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päivän tunnit kotinäytöllä avaamatta mitään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les heures du jour sur l’écran d’accueil, sans rien ouvrir."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mai órák a kezdőképernyőn, bármi megnyitása nélkül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jam hari ini di layar utama, tanpa membuka apa pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le ore di oggi sulla schermata Home, senza aprire nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを開かなくても、今日の時間がホーム画面に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱을 열지 않아도 오늘의 시간이 홈 화면에 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagens timer på hjemskjermen, uten å åpne noe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De uren van vandaag op het beginscherm, zonder iets te openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzisiejsze godziny na ekranie początkowym, bez otwierania czegokolwiek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As horas de hoje na tela de início, sem abrir nada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orele de azi pe ecranul principal, fără să deschizi nimic."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сегодняшние часы на домашнем экране, ничего открывать не нужно."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dnešné hodiny na domovskej obrazovke, bez toho, aby ste čokoľvek otvárali."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagens timmar på hemskärmen, utan att öppna något."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugünün saatleri ana ekranda, hiçbir şey açmadan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сьогоднішні години на головному екрані, нічого не відкриваючи."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天的时数直接显示在主屏幕上，不用打开应用。"
          }
        },
        "zh-Hant" : {
