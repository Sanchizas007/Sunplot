    "At %@, today. The year matters too — a bed that manages six hours in June may get two in September." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na místě „%@“ dnes. Záleží i na roce — záhon, který v červnu dostane šest hodin, jich může v září dostat dvě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På %@, i dag. Året betyder også noget — et bed med seks timer i juni kan få to i september."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute an %@. Das Jahr zählt auch — ein Beet mit sechs Stunden im Juni hat im September vielleicht zwei."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στο «%@», σήμερα. Μετράει και το έτος — ένα παρτέρι που παίρνει έξι ώρες τον Ιούνιο μπορεί να πάρει δύο τον Σεπτέμβριο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En «%@», hoy. El año también cuenta: un bancal con seis horas en junio puede tener dos en septiembre."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paikassa %@, tänään. Myös vuosi on tärkeä — penkki, joka saa kesäkuussa kuusi tuntia, voi saada syyskuussa kaksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À %@, aujourd’hui. L’année compte aussi : un massif qui obtient six heures en juin peut n’en avoir que deux en septembre."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, ma. Az év is számít — az az ágyás, amelyik júniusban hat órát kap, szeptemberben kaphat kettőt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di %@, hari ini. Tahun juga penting — bedengan yang dapat enam jam di bulan Juni bisa dapat dua jam di bulan September."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In «%@», oggi. Conta anche l'anno: un'aiuola con sei ore a giugno a settembre ne prende due."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」の今日の値です。一年の変化も大切で、6月に6時間ある花壇も9月には2時間になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 「%@」 기준입니다. 계절도 중요합니다. 6월에 여섯 시간인 화단이 9월에는 두 시간이 됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På %@, i dag. Året betyr også noe — et bed som får seks timer i juni kan få to i september."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij «%@», vandaag. Het jaar telt ook mee: een bed met zes uur in juni haalt er in september twee."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W miejscu «%@», dzisiaj. Rok też ma znaczenie: grządka z sześcioma godzinami w czerwcu we wrześniu dostanie dwie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em «%@», hoje. O ano também pesa: um canteiro com seis horas em junho pode ter duas em setembro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La „%@”, astăzi. Contează și anul — un strat care primește șase ore în iunie poate primi două în septembrie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точка «%@», сегодня. Год тоже важен: грядка с шестью часами в июне в сентябре получит два."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na mieste „%@“ dnes. Záleží aj na roku — záhon, ktorý v júni dostane šesť hodín, ich môže v septembri dostať dve."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På %@, i dag. Året spelar också roll — en bädd som får sex timmar i juni kan få två i september."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» noktasında, bugün. Yıl da önemli: haziranda altı saat alan bir tarh eylülde iki saat alabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У «%@», сьогодні. Рік теж важливий: грядка, що в червні має шість годин, у вересні може мати дві."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天在「%@」。全年也要看：六月有六小时的地，九月可能只有两小时。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天在「%@」。全年也要看：六月有六小時的地，九月可能只剩兩小時。"
          }
        }
      }
    },
