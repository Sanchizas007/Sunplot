    "When full sun starts and ends, and the weeks it gets none at all." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdy plné slunce začíná a končí a týdny, kdy nedostane žádné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvornår fuld sol begynder og slutter, og ugerne uden nogen overhovedet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wann die volle Sonne beginnt und endet — und die Wochen ganz ohne."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πότε αρχίζει και τελειώνει ο πλήρης ήλιος και οι εβδομάδες που δεν παίρνει καθόλου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuándo empieza y acaba el sol pleno, y las semanas en que no hay nada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Milloin täysi aurinko alkaa ja päättyy, ja viikot, jolloin sitä ei ole lainkaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand le plein soleil commence et finit, et les semaines sans rien du tout."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikor kezdődik és ér véget a teljes napfény, és mely hetekben nincs egyáltalán."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapan matahari penuh dimulai dan berakhir, dan minggu-minggu ketika tidak ada sama sekali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando comincia e finisce il pieno sole e le settimane senza niente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終日陽が始まる時期と終わる時期、まったく日が入らない週が分かります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "양지가 언제 시작되고 끝나는지, 햇빛이 전혀 없는 주는 언제인지."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når full sol begynner og slutter, og ukene den ikke får noen i det hele tatt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer volle zon begint en eindigt, en de weken zonder iets."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiedy pełne słońce się zaczyna i kończy oraz w które tygodnie nie ma go wcale."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o sol pleno começa e termina, e as semanas sem nada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când începe și se termină soarele plin și săptămânile în care nu primește deloc."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
