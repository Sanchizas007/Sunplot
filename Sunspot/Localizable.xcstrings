    "When full sun starts and ends, and the weeks it gets none at all." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wann die volle Sonne beginnt und endet — und die Wochen ganz ohne."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuándo empieza y acaba el sol pleno, y las semanas en que no hay nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand le plein soleil commence et finit, et les semaines sans rien du tout."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando comincia e finisce il pieno sole e le settimane senza niente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終日陽が始まる時期と終わる時期、まったく日が入らない週が分かります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "양지가 언제 시작되고 끝나는지, 햇빛이 전혀 없는 주는 언제인지."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer volle zon begint en eindigt, en de weken zonder iets."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiedy pełne słońce się zaczyna i kończy oraz w które tygodnie nie ma go wcale."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o sol pleno começa e termina, e as semanas sem nada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда полное солнце начинается и заканчивается и в какие недели его нет совсем."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam güneşin ne zaman başlayıp bittiği ve hiç olmadığı haftalar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全日照什么时候开始和结束，哪几周完全没有。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全日照什麼時候開始和結束，哪幾週完全沒有。"
          }
        }
      }
    },
