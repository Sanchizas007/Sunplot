    "Point the phone at the sky. The line is where the sun travels today, and the disc is where it is right now." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namiřte telefon na oblohu. Čára je dráha slunce dnes a kotouč místo, kde je právě teď."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ret telefonen mod himlen. Linjen er solens bane i dag, og skiven er, hvor den er lige nu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte das Telefon auf den Himmel. Die Linie zeigt, wo die Sonne heute entlangzieht, die Scheibe, wo sie gerade steht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στρέψε το τηλέφωνο προς τον ουρανό. Η γραμμή είναι η διαδρομή του ήλιου σήμερα και ο δίσκος εκεί που βρίσκεται αυτή τη στιγμή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apunta el teléfono al cielo. La línea es por donde pasa el sol hoy y el disco es donde está ahora mismo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suuntaa puhelin taivaalle. Viiva on auringon reitti tänään ja kiekko kohta, jossa se on juuri nyt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dirigez le téléphone vers le ciel. La ligne montre où passe le soleil aujourd’hui, et le disque où il se trouve en ce moment."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irányítsd a telefont az égre. A vonal a nap útja ma, a korong pedig az, ahol éppen van."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arahkan ponsel ke langit. Garis itu adalah jalur matahari hari ini, dan cakramnya adalah posisinya sekarang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punta il telefono verso il cielo. La linea è il percorso del sole oggi, il disco è dove si trova in questo momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端末を空に向けてください。線は今日の太陽の通り道、円は今この瞬間の太陽の位置です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기를 하늘로 향하세요. 선은 오늘 해가 지나는 길이고, 원은 지금 해가 있는 곳입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rett telefonen mot himmelen. Linjen er solbanen i dag, og skiven er der solen er akkurat nå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richt de telefoon op de lucht. De lijn is waar de zon vandaag langs trekt en de schijf is waar ze nu staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skieruj telefon na niebo. Linia to droga słońca dziś, a tarcza to miejsce, w którym jest teraz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aponte o telefone para o céu. A linha é por onde o sol passa hoje, e o disco é onde ele está agora."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Îndreaptă telefonul spre cer. Linia este traseul soarelui azi, iar discul este unde se află chiar acum."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Направьте телефон на небо. Линия — это путь солнца сегодня, а диск — то место, где оно сейчас."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namierte telefón na oblohu. Čiara je dráha slnka dnes a kotúč miesto, kde je práve teraz."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rikta telefonen mot himlen. Linjen är solens bana i dag och skivan är var den är just nu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonu gökyüzüne doğrult. Çizgi güneşin bugün izlediği yol, daire ise şu anda bulunduğu yerdir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спрямуйте телефон на небо. Лінія — це шлях сонця сьогодні, а диск — де воно зараз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把手机对准天空。线是今天太阳走过的路径，圆盘是它此刻所在的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把手機對準天空。線是今天太陽走過的路徑，圓盤是它此刻所在的位置。"
          }
        }
      }
    },
