        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El bancal de la valla y el del garaje responden distinto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aidan vieressä oleva penkki ja autotallin vieressä oleva vastaavat eri tavoin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
