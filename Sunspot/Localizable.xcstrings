    "Quick enough to fit into a gap between other crops." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dost rychlá, aby se vešla do mezery mezi jinými plodinami."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hurtig nok til at få plads i et hul mellem andre afgrøder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schnell genug für eine Lücke zwischen anderen Kulturen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αρκετά γρήγορο ώστε να χωρά σε ένα κενό ανάμεσα σε άλλες καλλιέργειες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crece rápido y cabe entre otros cultivos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niin nopea, että mahtuu muiden kasvien väliin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assez rapide pour combler un vide entre deux cultures."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elég gyors ahhoz, hogy beférjen más növények közti résbe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cukup cepat untuk muat di celah di antara tanaman lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cresce in fretta e sta in mezzo ad altre colture."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生育が早く、ほかの作物の合間に収まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자라는 속도가 빨라 다른 작물 사이에 끼워 심기 좋습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rask nok til å få plass i et gap mellom andre vekster."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groeit snel genoeg om tussen andere gewassen te passen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rośnie szybko i zmieści się między innymi uprawami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cresce rápido e cabe no intervalo entre outras plantas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destul de rapidă încât să încapă într-un gol dintre alte culturi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Растёт быстро и влезает между другими посадками."
          }
        },
        "sk" : {
          "stringUnit" : {
