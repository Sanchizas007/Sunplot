    "Could not get a position just now. Pick a spot on the map instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polohu teď nelze zjistit. Vyberte místo na mapě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke få en position lige nu. Vælg i stedet et sted på kortet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Momentan keine Position zu bekommen. Wähle stattdessen eine Stelle auf der Karte."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατός ο εντοπισμός θέσης αυτή τη στιγμή. Διάλεξε ένα σημείο στον χάρτη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo obtener la ubicación. Elige un punto en el mapa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sijaintia ei saatu juuri nyt. Valitse paikka kartalta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’obtenir une position pour l’instant. Choisissez plutôt un emplacement sur la carte."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most nem sikerült meghatározni a pozíciót. Válassz helyet a térképen."
