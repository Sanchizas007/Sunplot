        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berichtgevingen staan uit voor Sunplot. Zet ze aan in Instellingen, dan gaat dit werken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiadomienia dla Sunplot są wyłączone. Włącz je w Ustawieniach, a to zacznie działać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As notificações estão desligadas para o Sunplot. Ligue em Ajustes e isto começará a funcionar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notificările sunt dezactivate pentru Sunplot. Activează-le în Setări și va începe să funcționeze."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
