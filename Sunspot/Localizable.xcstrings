    "Fruit will not ripen properly under six hours." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovoce pod šest hodin řádně nedozraje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frugt modner ikke ordentligt på under seks timer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter sechs Stunden reifen die Früchte nicht richtig aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα φρούτα δεν ωριμάζουν σωστά σε λιγότερο από έξι ώρες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con menos de seis horas la fruta no madura bien."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hedelmät eivät kypsy kunnolla alle kuudessa tunnissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En dessous de six heures, les fruits ne mûrissent pas correctement."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gyümölcs hat óra alatt nem érik be rendesen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buah tidak akan matang dengan baik dalam kurang dari enam jam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto le sei ore la frutta non matura bene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6時間を切ると果実はうまく熟しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여섯 시간 미만이면 열매가 제대로 익지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frukt modnes ikke ordentlig på under seks timer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onder zes uur rijpt fruit niet goed."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poniżej sześciu godzin owoce nie dojrzeją jak należy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com menos de seis horas a fruta não amadurece direito."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fructele nu se coc cum trebuie în mai puțin de șase ore."
