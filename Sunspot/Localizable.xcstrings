    "Something you will recognise: the bed by the fence, the balcony, the shed roof." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Něco, co poznáte: záhon u plotu, balkon, střecha kůlny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noget, du kan genkende: bedet ved hegnet, altanen, skurets tag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas, das du wiedererkennst: das Beet am Zaun, der Balkon, das Schuppendach."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάτι που θα αναγνωρίσεις: το παρτέρι δίπλα στον φράχτη, το μπαλκόνι, η στέγη του αποθηκευτικού χώρου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo que reconozcas: el bancal de la valla, el balcón, el tejado del cobertizo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jotain tuttua: penkki aidan vieressä, parveke, vajan katto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelque chose que vous reconnaîtrez : le massif près de la clôture, le balcon, le toit de l’abri."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valami ismerős: az ágyás a kerítésnél, az erkély, a fészer teteje."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesuatu yang kamu kenali: bedengan di dekat pagar, balkon, atap gudang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcosa che riconosci: l'aiuola vicino alla recinzione, il balcone, il tetto del capanno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あとで分かる名前を。フェンス際の花壇、ベランダ、物置の屋根など。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나중에 알아볼 이름으로. 울타리 옆 화단, 발코니, 창고 지붕처럼."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noe du kjenner igjen: bedet ved gjerdet, balkongen, taket på uthuset."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iets dat je herkent: het bed bij de schutting, het balkon, het schuurdak."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coś, co rozpoznasz: grządka przy płocie, balkon, dach szopy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo que você reconheça: o canteiro da cerca, a varanda, o telhado do galpão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceva ce recunoști: stratul de lângă gard, balconul, acoperișul magaziei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы вы узнали: грядка у забора, балкон, крыша сарая."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niečo, čo spoznáte: záhon pri plote, balkón, strecha kôlne."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Något du känner igen: bädden vid staketet, balkongen, bodtaket."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanıyacağın bir ad: çitin yanındaki tarh, balkon, kulübenin çatısı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щось знайоме: грядка біля паркану, балкон, дах сараю."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起个一眼认得出的名字：篱笆边的地、阳台、棚顶。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取個一眼認得出的名字：籬笆邊的地、陽台、棚頂。"
          }
        }
      }
    },
