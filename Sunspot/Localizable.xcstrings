    "Sunplot needs a position to work out where the sun travels overhead." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot braucht eine Position, um den Sonnenlauf über dieser Stelle zu berechnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot necesita una posición para calcular por dónde pasa el sol."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot a besoin d’une position pour calculer la course du soleil au-dessus de cet endroit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot ha bisogno di una posizione per calcolare dove passa il sole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplotは、太陽がどこを通るか計算するために場所が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot은 해가 어디를 지나는지 계산하기 위해 위치가 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot heeft een positie nodig om te berekenen waar de zon overheen trekt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot potrzebuje położenia, żeby wyliczyć, którędy przechodzi słońce."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sunplot precisa de uma posição para calcular por onde o sol passa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot нужна точка, чтобы рассчитать, где над ней проходит солнце."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot, güneşin tepeden nereden geçtiğini hesaplamak için bir konuma ihtiyaç duyar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot 需要一个位置，才能算出太阳从上空怎么走。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot 需要一個位置，才能算出太陽從上空怎麼走。"
          }
        }
      }
    },
    "Sweep along the tops of the roofs and trees" : {
