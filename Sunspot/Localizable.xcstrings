    "Never six hours in a day. Beans, carrots and herbs will manage; fruiting crops will not." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nikdy šest hodin za den. Fazole, mrkev a bylinky si poradí; plodiny s plody ne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aldrig seks timer på en dag. Bønner, gulerødder og krydderurter klarer sig; frugtafgrøder gør ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie sechs Stunden am Tag. Bohnen, Karotten und Kräuter kommen zurecht, Fruchtgemüse nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ποτέ έξι ώρες σε μία μέρα. Τα φασόλια, τα καρότα και τα βότανα τα καταφέρνουν· οι καρποφόρες καλλιέργειες όχι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca seis horas en un día. Judías, zanahorias y hierbas se apañan; los cultivos de fruto no."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei koskaan kuutta tuntia päivässä. Pavut, porkkanat ja yrtit pärjäävät; hedelmää tuottavat kasvit eivät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamais six heures dans la journée. Haricots, carottes et herbes s’en sortiront ; les cultures à fruits, non."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soha nincs hat óra egy napon. A bab, a sárgarépa és a fűszernövények boldogulnak; a termést hozó növények nem."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak pernah enam jam dalam sehari. Buncis, wortel, dan herba bisa bertahan; tanaman berbuah tidak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mai sei ore in un giorno. Fagioli, carote ed erbe se la cavano; gli ortaggi da frutto no."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日6時間には届きません。インゲン、ニンジン、ハーブなら育ちますが、実をつける作物は無理です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루 여섯 시간에 이르지 않습니다. 강낭콩, 당근, 허브는 자라지만 열매채소는 어렵습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aldri seks timer på en dag. Bønner, gulrøtter og krydderurter klarer seg; frukt- og bærvekster gjør det ikke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nooit zes uur op een dag. Bonen, wortels en kruiden redden het; vruchtgewassen niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nigdy sześciu godzin dziennie. Fasola, marchew i zioła dadzą radę; rośliny owocujące nie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca seis horas por dia. Feijão, cenoura e ervas se viram; as frutíferas não."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niciodată șase ore pe zi. Fasolea, morcovii și ierburile se descurcă; plantele cu fructe, nu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шести часов в день не бывает. Фасоль, морковь и травы справятся, плодовые — нет."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nikdy šesť hodín za deň. Fazuľa, mrkva a bylinky si poradia; plodiny s plodmi nie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aldrig sex timmar på en dag. Bönor, morötter och kryddor klarar sig; grödor som ska bära frukt gör det inte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günde altı saat hiç olmuyor. Fasulye, havuç ve otlar idare eder; meyve veren bitkiler edemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жодного дня з шістьма годинами. Квасоля, морква й трави впораються; плодові культури — ні."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一天从没有六小时。菜豆、胡萝卜和香草还行，结果的作物不行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一天從沒有六小時。四季豆、胡蘿蔔和香草還行，結果的作物不行。"
          }
        }
      }
    },
