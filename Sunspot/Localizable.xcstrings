    "At %@, today. The year matters too — a bed that manages six hours in June may get two in September." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute an %@. Das Jahr zählt auch — ein Beet mit sechs Stunden im Juni hat im September vielleicht zwei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En «%@», hoy. El año también cuenta: un bancal con seis horas en junio puede tener dos en septiembre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À %@, aujourd’hui. L’année compte aussi : un massif qui obtient six heures en juin peut n’en avoir que deux en septembre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In «%@», oggi. Conta anche l'anno: un'aiuola con sei ore a giugno a settembre ne prende due."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」の今日の値です。一年の変化も大切で、6月に6時間ある花壇も9月には2時間になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 「%@」 기준입니다. 계절도 중요합니다. 6월에 여섯 시간인 화단이 9월에는 두 시간이 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij «%@», vandaag. Het jaar telt ook mee: een bed met zes uur in juni haalt er in september twee."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W miejscu «%@», dzisiaj. Rok też ma znaczenie: grządka z sześcioma godzinami w czerwcu we wrześniu dostanie dwie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em «%@», hoje. O ano também pesa: um canteiro com seis horas em junho pode ter duas em setembro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точка «%@», сегодня. Год тоже важен: грядка с шестью часами в июне в сентябре получит два."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» noktasında, bugün. Yıl da önemli: haziranda altı saat alan bir tarh eylülde iki saat alabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天在「%@」。全年也要看：六月有六小时的地，九月可能只有两小时。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天在「%@」。全年也要看：六月有六小時的地，九月可能只剩兩小時。"
          }
        }
      }
    },
