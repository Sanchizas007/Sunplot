    "The bed by the fence and the one by the garage answer differently." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Záhon u plotu a ten u garáže odpovídají různě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedet ved hegnet og det ved garagen svarer forskelligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Beet am Zaun und das an der Garage antworten unterschiedlich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το παρτέρι δίπλα στον φράχτη και αυτό δίπλα στο γκαράζ απαντούν διαφορετικά."
          }
