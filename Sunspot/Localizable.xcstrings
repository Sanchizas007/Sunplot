    "Keep a finger on the tops of the roofs and trees and turn on the spot. Only the sun above that line counts." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Držte prst na střechách a korunách stromů a otáčejte se na místě. Počítá se jen slunce nad touto čarou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold en finger på toppen af tage og træer og drej rundt på stedet. Kun solen over den linje tæller."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte den Finger an den Kanten der Dächer und Bäume und drehe dich auf der Stelle. Nur die Sonne über dieser Linie zählt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κράτα το δάχτυλο στις κορυφές των στεγών και των δέντρων και στρίψε στο σημείο. Μετράει μόνο ο ήλιος πάνω από αυτή τη γραμμή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén el dedo sobre el borde de los tejados y los árboles y gira sobre ti mismo. Solo cuenta el sol que queda por encima de esa línea."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä sormi kattojen ja puiden latvoilla ja käänny paikallasi. Vain viivan yläpuolinen aurinko lasketaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez le doigt sur le sommet des toits et des arbres et tournez sur place. Seul le soleil au-dessus de cette ligne compte."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartsd az ujjad a tetők és fák tetején, és fordulj körbe a helyeden. Csak a vonal feletti nap számít."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahan jarimu di puncak atap dan pohon lalu berputarlah di tempat. Hanya matahari di atas garis itu yang dihitung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni il dito sulle cime di tetti e alberi e gira su te stesso. Conta solo il sole sopra quella linea."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屋根や木のてっぺんに指をあてたまま、その場で体を回してください。線より上の太陽だけが数えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지붕과 나무 꼭대기에 손가락을 대고 제자리에서 도세요. 그 선보다 위에 있는 해만 계산됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold en finger på toppen av tak og trær og snu deg rundt på stedet. Bare solen over den linjen teller."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd je vinger op de toppen van daken en bomen en draai om je as. Alleen de zon boven die lijn telt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trzymaj palec na szczytach dachów i drzew i obracaj się w miejscu. Liczy się tylko słońce nad tą linią."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o dedo no topo dos telhados e das árvores e gire no lugar. Só conta o sol acima dessa linha."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ține degetul pe vârfurile acoperișurilor și ale copacilor și rotește-te pe loc. Contează doar soarele de deasupra liniei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите палец на верхушках крыш и деревьев и поворачивайтесь на месте. Считается только солнце над этой линией."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Držte prst na strechách a korunách stromov a otáčajte sa na mieste. Počíta sa len slnko nad touto čiarou."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll fingret på takåsarna och trädtopparna och vrid dig runt. Bara solen ovanför linjen räknas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parmağını çatıların ve ağaçların tepesinde tut ve olduğun yerde dön. Yalnızca bu çizginin üstündeki güneş sayılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тримайте палець на верхівках дахів і дерев і повертайтеся на місці. Враховується лише сонце над цією лінією."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手指按在屋顶和树梢上，原地转身。只有这条线以上的阳光才算数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手指按在屋頂和樹梢上，原地轉身。只有這條線以上的陽光才算數。"
          }
        }
      }
    },
