{
  "sourceLanguage" : "en",
  "strings" : {
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot používá fotoaparát, abyste mohli obkreslit střechy a stromy kolem místa."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot bruger kameraet, så du kan aftegne tage og træer omkring et sted."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot nutzt die Kamera, damit du Dächer und Bäume rund um eine Stelle nachzeichnen kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Sunplot χρησιμοποιεί την κάμερα για να σχεδιάσεις τις στέγες και τα δέντρα γύρω από ένα σημείο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot uses the camera so you can trace the roofs and trees around a spot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot usa la cámara para que puedas trazar los tejados y árboles alrededor de un punto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot käyttää kameraa, jotta voit piirtää paikan ympärillä olevat katot ja puut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot utilise l’appareil photo pour vous permettre de tracer les toits et les arbres autour d’un emplacement."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Sunplot a kamerát használja, hogy körberajzolhasd a hely körüli tetőket és fákat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot memakai kamera agar kamu bisa menggambar atap dan pohon di sekitar sebuah titik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot usa la fotocamera per farti tracciare tetti e alberi attorno a un punto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplotは、場所のまわりの屋根や木立をなぞれるようにカメラを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot은 자리 주변의 지붕과 나무를 그릴 수 있도록 카메라를 사용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot bruker kameraet slik at du kan tegne av tak og trær rundt et sted."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot gebruikt de camera zodat je de daken en bomen rond een plek kunt natekenen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot używa aparatu, żebyś mógł obrysować dachy i drzewa wokół miejsca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sunplot usa a câmera para você traçar os telhados e as árvores em volta de um ponto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot folosește camera ca să poți trasa acoperișurile și copacii din jurul unui loc."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot использует камеру, чтобы вы могли обвести крыши и деревья вокруг точки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot používa fotoaparát, aby ste mohli obkresliť strechy a stromy okolo miesta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot använder kameran så att du kan rita av taken och träden runt en plats."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot, bir noktanın çevresindeki çatıları ve ağaçları çizebilmen için kamerayı kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
