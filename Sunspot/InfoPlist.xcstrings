          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot 使用相机，让你描出地点周围的屋顶和树。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot 使用相機，讓你描出地點周圍的屋頂和樹。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot potřebuje vaši polohu, aby vypočítal, jak slunce nad tímto místem putuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot har brug for din position for at regne ud, hvordan solen bevæger sig over dette sted."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot braucht deinen Standort, um den Sonnenlauf über dieser Stelle zu berechnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Sunplot χρειάζεται την τοποθεσία σου για να υπολογίσει πώς κινείται ο ήλιος πάνω από αυτό το σημείο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot needs your location to work out where the sun travels over this spot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot necesita tu ubicación para calcular por dónde pasa el sol sobre este punto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot tarvitsee sijaintisi laskeakseen, miten aurinko kulkee tämän paikan yllä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot a besoin de votre position pour calculer la course du soleil au-dessus de cet endroit."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Sunplotnak szüksége van a helyzetedre, hogy kiszámítsa, hogyan halad a nap e hely felett."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot memerlukan lokasimu untuk menghitung bagaimana matahari bergerak di atas titik ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot ha bisogno della tua posizione per calcolare dove passa il sole sopra questo punto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplotは、この場所の上を太陽がどう通るか計算するために位置情報を使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot은 이 자리 위로 해가 지나는 길을 계산하기 위해 위치가 필요합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot trenger posisjonen din for å regne ut hvordan solen beveger seg over dette stedet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot heeft je locatie nodig om te berekenen waar de zon over deze plek loopt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot potrzebuje twojej lokalizacji, żeby wyliczyć drogę słońca nad tym miejscem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sunplot precisa da sua localização para calcular por onde o sol passa sobre este ponto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot are nevoie de locația ta ca să calculeze cum călătorește soarele deasupra acestui loc."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot нужна ваша геопозиция, чтобы рассчитать путь солнца над этой точкой."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot potrebuje vašu polohu, aby vypočítal, ako slnko nad týmto miestom putuje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot behöver din plats för att räkna ut hur solen färdas över den här platsen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot, güneşin bu noktanın üstünden nereden geçtiğini hesaplamak için konumunu kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot потрібна ваша геолокація, щоб розрахувати, як сонце рухається над цією точкою."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot 需要你的位置，才能算出太阳从这个地点上空怎么走。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot 需要你的位置，才能算出太陽從這個地點上空怎麼走。"
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot zjišťuje, kam telefon míří, aby dráha slunce seděla s tím, co vidí fotoaparát."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot aflæser, hvilken vej telefonen peger, så solens bane flugter med det, kameraet ser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot liest aus, wohin das Telefon zeigt, damit der Sonnenlauf zum Kamerabild passt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Sunplot διαβάζει προς τα πού δείχνει το τηλέφωνο, ώστε η διαδρομή του ήλιου να συμπίπτει με ό,τι βλέπει η κάμερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot reads which way the phone is pointing so the sun's path lines up with what the camera sees."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot lee hacia dónde apunta el teléfono para que el recorrido del sol coincida con lo que ve la cámara."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot lukee, mihin suuntaan puhelin osoittaa, jotta auringon reitti osuu yksiin kameran näkemän kanssa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot lit l’orientation du téléphone pour aligner la course du soleil sur ce que voit l’appareil photo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Sunplot leolvassa, merre mutat a telefon, hogy a nap útja egybeessen azzal, amit a kamera lát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot membaca arah yang ditunjuk ponsel agar jalur matahari sejajar dengan yang dilihat kamera."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot rileva dove è puntato il telefono così il percorso del sole combacia con ciò che vede la fotocamera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplotは、太陽の通り道をカメラの映像と合わせるため、端末の向きを読み取ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot은 해의 경로를 카메라 화면과 맞추기 위해 기기가 향한 방향을 읽습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot leser av hvilken vei telefonen peker, slik at solbanen flukter med det kameraet ser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot leest af welke kant de telefoon op wijst, zodat de zonnebaan klopt met wat de camera ziet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot odczytuje, w którą stronę skierowany jest telefon, żeby droga słońca zgadzała się z obrazem z aparatu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sunplot lê para onde o telefone aponta, assim o caminho do sol coincide com o que a câmera vê."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot citește încotro e orientat telefonul, ca traseul soarelui să se potrivească cu ce vede camera."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot определяет, куда направлен телефон, чтобы путь солнца совпал с тем, что видит камера."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot zisťuje, kam telefón mieri, aby dráha slnka sedela s tým, čo vidí fotoaparát."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot läser av åt vilket håll telefonen pekar så att solens bana linjerar med det kameran ser."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot, güneşin yolu kameranın gördüğüyle örtüşsün diye telefonun hangi yöne baktığını okur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot зчитує, куди спрямовано телефон, щоб шлях сонця збігався з тим, що бачить камера."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot 读取手机朝向，让太阳的轨迹和相机看到的画面对齐。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunplot 讀取手機朝向，讓太陽的軌跡和相機看到的畫面對齊。"
          }
        }
      }
    }
  },
  "version" : "1.0"
